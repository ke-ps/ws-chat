# ============================================================
# backend/.env
# ============================================================
# Copia este archivo a .env y rellena los valores

# ---- Base de datos MySQL (Aiven) ----
# Enlace de conexión de Aiven Console > tu servicio > Connection Details
DATABASE_URL=mysql+pymysql://avnadmin:TU_PASSWORD@TU_HOST:25185/defaultdb

# ---- Firebase Admin SDK ----
# Ruta al archivo JSON del service account
# Descargar desde: Firebase Console > Project Settings > Service Accounts
# > Generate new private key
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json